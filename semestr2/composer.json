{
    "name": "shoperup/semestr2",
    "description": "Projekt PHP - semestr 2",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "twig/twig": "^3.0",
        "symfony/dotenv": "^8.0",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
