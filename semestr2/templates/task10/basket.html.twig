<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Koszyk</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px; }
        .basket-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .basket-table th, .basket-table td { border-bottom: 1px solid #ddd; padding: 12px; text-align: left; }
        .total-section { text-align: right; font-size: 1.2em; font-weight: bold; border-top: 2px solid #333; padding-top: 10px; }
        .currency { color: #d35400; }
    </style>
</head>
<body>

    {% include 'task10/header.html.twig' %}

    <main>
        <h2>Twoje produkty</h2>
        <table class="basket-table">
            <thead>
                <tr>
                    <th>Nazwa produktu</th>
                    <th style="text-align: right;">Cena</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.getName() }}</td>
                        <td style="text-align: right;">
                            {{ product.getPrice()|number_format(2, ',', ' ') }} zł
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2">Koszyk jest pusty.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="total-section">
            Suma do zapłaty: <span class="currency">{{ total|number_format(2, ',', ' ') }} zł</span>
        </div>
    </main>

    {% include 'task10/footer.html.twig' %}

</body>
</html>